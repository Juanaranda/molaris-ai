{
  "name": "molari-ai",
  "version": "0.1.0",
  "description": "AI Growth System for dental clinics",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "start:prod": "prisma db push --skip-generate && node dist/index.js",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/formbody": "^8.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@google/genai": "^2.0.1",
    "@prisma/client": "^6.19.2",
    "axios": "^1.7.7",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.5",
    "fastify": "^5.1.0",
    "groq-sdk": "^1.1.1",
    "jsonwebtoken": "^9.0.3",
    "papaparse": "^5.5.3",
    "prisma": "^6.19.2",
    "twilio": "^5.13.1",
    "zod": "^3.23.8"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.7.5",
    "@types/papaparse": "^5.5.2",
    "@vitest/coverage-v8": "^4.1.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^4.1.5"
  }
}
