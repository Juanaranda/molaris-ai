generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PartnerRole {
  SUPERADMIN
  ADMIN
  USER
}

// ─── CLÍNICA (TENANT) ────────────────────────────────────────────────────────
model Clinic {
  id        String   @id @default(cuid())
  slug      String   @unique          // ej: "galana"
  name      String
  phone     String?
  whatsapp  String?
  instagram String?
  location  String?
  config    Json                      // servicios, horarios, tono (reemplaza galana.ts)
  apiKey    String   @unique @default(cuid())
  plan      String   @default("starter")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patients     Patient[]
  sessions     Session[]
  bookings     Booking[]
  partnerUsers PartnerUser[]
  patientUsers PatientUser[]
  usageEvents  UsageEvent[]

  @@map("clinics")
}

// ─── USUARIOS PARTNER (CLÍNICAS) ─────────────────────────────────────────────
model PartnerUser {
  id               String      @id @default(cuid())
  clinicId         String?
  clinic           Clinic?     @relation(fields: [clinicId], references: [id])
  name             String
  email            String      @unique
  passwordHash     String
  role             PartnerRole @default(USER)
  active           Boolean     @default(true)
  acceptedTermsAt  DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@map("partner_users")
}

// ─── IDENTIDAD (PERSONA UNIVERSAL — RUT como identificador único) ────────────
model Identity {
  id         String        @id @default(cuid())
  rut        String        @unique
  firstName  String
  lastName   String
  email      String?       @unique
  phone      String?
  birthDate  DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  patientUsers PatientUser[]
  patients     Patient[]

  @@map("identities")
}

// ─── USUARIO PACIENTE (IDENTIDAD ENROLADA EN UNA CLÍNICA) ────────────────────
model PatientUser {
  id           String    @id @default(cuid())
  identityId   String
  identity     Identity  @relation(fields: [identityId], references: [id])
  clinicId     String
  clinic       Clinic    @relation(fields: [clinicId], references: [id])
  passwordHash String?
  enrolledAt   DateTime  @default(now())
  lastVisit    DateTime?
  notes        String?
  active       Boolean   @default(true)

  bookings     Booking[]

  @@unique([identityId, clinicId])
  @@map("patient_users")
}

// ─── PACIENTE ────────────────────────────────────────────────────────────────
model Patient {
  id         String    @id @default(cuid())
  clinicId   String
  clinic     Clinic    @relation(fields: [clinicId], references: [id])
  identityId String?
  identity   Identity? @relation(fields: [identityId], references: [id])
  name       String?
  phone      String?
  email      String?
  channel    String?   // "whatsapp" | "web" | "instagram"
  createdAt  DateTime  @default(now())

  sessions   Session[]

  @@map("patients")
}

// ─── SESIÓN (CONVERSACIÓN) ───────────────────────────────────────────────────
model Session {
  id        String   @id @default(cuid())
  clinicId  String
  clinic    Clinic   @relation(fields: [clinicId], references: [id])
  patientId String?
  patient   Patient? @relation(fields: [patientId], references: [id])
  channel   String   @default("web")
  status    String   @default("open")  // "open" | "booked" | "closed"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages  Message[]
  context   PatientContext?

  @@map("sessions")
}

// ─── MENSAJES ────────────────────────────────────────────────────────────────
model Message {
  id        String   @id @default(cuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id])
  role      String   // "user" | "assistant"
  content   String
  createdAt DateTime @default(now())

  @@map("messages")
}

// ─── CONTEXTO / LEAD SCORE ───────────────────────────────────────────────────
model PatientContext {
  id              String   @id @default(cuid())
  sessionId       String   @unique
  session         Session  @relation(fields: [sessionId], references: [id])
  patientName     String?
  rut             String?
  email           String?
  serviceInterest String?  // ej: "implante dental"
  urgency         String?  // "high" | "medium" | "low"
  intent          String?  // "ready_to_book" | "evaluating" | "just_browsing"
  score           Int?     // 0-100
  notes           String?  // info adicional extraída
  slotBooked      Boolean  @default(false)
  updatedAt       DateTime @updatedAt

  @@map("patient_contexts")
}

// ─── EVENTOS DE USO (MONITOREO INTERNO) ──────────────────────────────────────
model UsageEvent {
  id         String   @id @default(cuid())
  clinicId   String
  clinic     Clinic   @relation(fields: [clinicId], references: [id])
  sessionId  String?
  model      String
  tier       String   // "fast" | "balanced" | "smart"
  tokensIn   Int      @default(0)
  tokensOut  Int      @default(0)
  costUsd    Float    @default(0)
  latencyMs  Int?
  createdAt  DateTime @default(now())

  @@index([clinicId])
  @@index([createdAt])
  @@map("usage_events")
}

// ─── BOOKINGS (CITAS CONFIRMADAS) ────────────────────────────────────────────
model Booking {
  id            String       @id @default(cuid())
  clinicId      String
  clinic        Clinic       @relation(fields: [clinicId], references: [id])
  patientUserId String?
  patientUser   PatientUser? @relation(fields: [patientUserId], references: [id])
  sessionId     String?
  patientName   String?
  service       String?
  date          DateTime
  time          String
  doctor        String
  box           String?
  status        String       @default("pending") // "pending" | "confirmed" | "cancelled"
  createdAt     DateTime     @default(now())

  @@map("bookings")
}
