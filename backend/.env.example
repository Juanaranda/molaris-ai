# ── Base de datos ────────────────────────────────────────────────────────────
# Railway: copia el valor de "DATABASE_URL" desde Variables de tu proyecto
DATABASE_URL="postgresql://user:password@host:5432/molari_ai"

# ── Servidor ─────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production
FRONTEND_URL="https://tu-app.vercel.app"

# ── Autenticación ────────────────────────────────────────────────────────────
# Genera con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="cambia-esto-en-produccion-con-un-valor-aleatorio-largo"

# ── IA (OpenRouter) ──────────────────────────────────────────────────────────
# https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-v1-..."
OPENROUTER_MODEL_FAST="meta-llama/llama-3.1-8b-instruct:free"
OPENROUTER_MODEL_BALANCED="anthropic/claude-haiku-4-5"
OPENROUTER_MODEL_SMART="anthropic/claude-haiku-4-5"
OPENROUTER_MODEL_RESERVE="google/gemini-2.5-flash"

# ── Twilio (WhatsApp) ────────────────────────────────────────────────────────
# https://console.twilio.com → Account SID + Auth Token
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="tu_auth_token_aqui"
# Sandbox local: "whatsapp:+14155238886" | Producción: "whatsapp:+56XXXXXXXXX"
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
